DATABASE_URL=postgresql://username:password@host:5432/database
AUTO_CREATE_SCHEMA=false
ENABLE_INTERNAL_SCHEDULER=false
# Local source-material storage is intentionally rejected in hosted mode.
# Keep Unified Intake uploads disabled until a durable object-storage backend is configured.
SOURCE_MATERIAL_STORAGE_BACKEND=local
SOURCE_MATERIAL_MAX_BYTES=26214400
