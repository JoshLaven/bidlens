DATABASE_URL=postgresql://username:password@host:5432/database
AUTO_CREATE_SCHEMA=false
ENABLE_INTERNAL_SCHEDULER=false
# Durable S3-compatible storage is required in hosted mode. Never use Railway ephemeral disk.
SOURCE_MATERIAL_STORAGE_BACKEND=s3
SOURCE_MATERIAL_MAX_BYTES=26214400
SOURCE_MATERIAL_S3_BUCKET=replace-with-private-bucket
SOURCE_MATERIAL_S3_ENDPOINT_URL=https://replace-with-s3-compatible-endpoint
SOURCE_MATERIAL_S3_REGION=us-east-1
SOURCE_MATERIAL_S3_ACCESS_KEY_ID=replace-with-storage-access-key
SOURCE_MATERIAL_S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
SOURCE_MATERIAL_S3_PATH_PREFIX=bidlens/source-materials
SOURCE_MATERIAL_S3_USE_SSL=true
INTAKE_DOCUMENT_MAX_TEXT_CHARS=60000
INTAKE_DOCUMENT_MAX_PDF_PAGES=50
INTAKE_EXTRACTION_MODEL=gpt-4o-mini
INTAKE_EXTRACTION_TIMEOUT_SECONDS=30
INTAKE_EXTRACTION_MAX_OUTPUT_TOKENS=1800
INTAKE_EMAIL_MAX_BODY_CHARS=20000
INTAKE_EMAIL_MAX_ATTACHMENTS=10
INTAKE_EMAIL_MAX_ATTACHMENT_BYTES=15728640
INTAKE_EMAIL_MAX_TOTAL_ATTACHMENT_BYTES=20971520
INTAKE_EMAIL_MAX_EXTRACTION_CHARS=80000
INTAKE_EMAIL_MAX_PARSING_SECONDS=15
